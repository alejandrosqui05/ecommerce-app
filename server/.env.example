# Base de datos (Supabase Postgres - usar la "Connection string" en modo pooling/transaction para runtime
# y la directa para migraciones si tu plan lo requiere)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase (para Storage). Se obtienen en Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Auth
JWT_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Credenciales del admin inicial (usadas solo por el script de seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
